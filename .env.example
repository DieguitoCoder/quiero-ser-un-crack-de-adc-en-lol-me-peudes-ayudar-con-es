# Climb Tracker v2. Copy to .env.local (never commit it). On Vercel set these in Project Settings.
# Public (shipped to the browser): only NEXT_PUBLIC_*.

APP_URL=http://localhost:4200

# Supabase (Auth only from the browser/SSR client; data goes through DATABASE_URL on the server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used ONLY for auth admin (create/delete users, RSO login). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Supavisor pooled URL, transaction mode (port 6543). Empty → local PGlite.
DATABASE_URL=

# Riot (server-only key; production key required for multi-user/RSO)
RIOT_API_KEY=
RIOT_PLATFORM=la1
RIOT_REGION=americas
# 1 = read Riot responses from tests/fixtures (no key needed)
RIOT_MOCK=0

# Dev/test only: fake signed-in user. App refuses to start with AUTH_MOCK=1 in production.
AUTH_MOCK=0

# Riot Sign-On ("Iniciar sesión con Riot"); enable once Riot approves the app
RSO_ENABLED=0
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
RSO_REDIRECT_URI=http://localhost:4200/api/auth/rso/callback

# Dev/test only: fixed mock user id (uuid) when AUTH_MOCK=1
MOCK_USER_ID=
